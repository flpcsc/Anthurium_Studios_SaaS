{
  "name": "@video-saas/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node -e \"console.log('database: no tests yet')\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@video-saas/config-eslint": "workspace:*",
    "@video-saas/config-ts": "workspace:*",
    "eslint": "9.39.1",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "5.9.3"
  }
}
